    "requires": "ps -eo pid=,ppid=,uid=,pcpu=,rss=,etimes=,stat=,args= 2>/dev/null | grep -q '[0-9]'",
    "query": "killcaseneedle", "minRows": 1, "row": 0, "view": "processes",
    "fields": ["title", "subtitle", "pid", "user", "own", "cpu", "mem", "memShare", "age", "count", "stopped", "windowed", "cmd", "exec", "actions", "machine", "score"],
    "matches": { "title": "^sleep", "cmd": "killcaseneedle",
                 "exec": "^kill -TERM [0-9]+$", "pid": "^[0-9]+$",
                 "own": "^True$", "windowed": "^False$", "stopped": "^False$",
                 "machine": "'bare': False",
